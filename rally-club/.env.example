# ============================================================================
# The Rally Club — Environment Variables
# ============================================================================
# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables for
# production/preview deployments.
#
# NEVER commit .env.local or any file containing real secrets.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Required for the Stripe webhook (lib/supabase/server.ts createAdminClient)
# and the admin bookings CSV export. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ------------------------------------------------------------------
# Create a Stripe account (or use an existing one) at https://dashboard.stripe.com
# Start in TEST MODE — see README section 7 for the full walkthrough.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From Stripe Dashboard → Developers → Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Resend) ----------------------------------------------------------
# Create an API key at https://resend.com/api-keys and verify a sending
# domain before going live. Until these are set, notification and booking
# confirmation emails are safely skipped (bookings/messages still save).
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=Rally Club <notifications@yourdomain.com>
NOTIFICATION_EMAIL_TO=holly@therallyclubuk.com

# --- Site --------------------------------------------------------------------
# The canonical production URL, used for SEO metadata, sitemap, structured
# data, and Stripe Checkout success/cancel redirect URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://therallyclubuk.com
